# Copy to .env (same directory) and fill in. Loaded automatically on backend startup.

# The Strategy Builder's "Parse with AI" feature auto-picks a backend at parse
# time. Fallback chain (each tier tried only if the earlier ones failed / are
# unconfigured):
#   OpenAI-compatible (all 3 vars set) -> Claude (key set)
#     -> local Ollama (always tried next) -> local offline regex parser.
# Force one tier with NL_PARSER_BACKEND (openai_compat | anthropic | ollama | local).
# NL_PARSER_BACKEND=

# OpenAI-compatible endpoint (a reseller/proxy token, a self-hosted
# OpenAI-compatible server, etc.) — any provider implementing the standard
# /chat/completions API with function/tool calling. Needs all three:
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=          # e.g. https://api.example.com/v1  (no trailing /chat/completions)
# OPENAI_COMPAT_MODEL=             # the model name that provider expects

# Anthropic (best accuracy, needs a key + network + small per-call cost).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (local model, no key/cost, lower accuracy than Claude on tricky
# phrasing). Install with `winget install Ollama.Ollama`, then
# `ollama pull qwen2.5:7b-instruct` (or your own model) before use.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional: Postgres connection overrides (defaults match db/config.py)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=xauusd_dev_pw
# PGDATABASE=xauusd
